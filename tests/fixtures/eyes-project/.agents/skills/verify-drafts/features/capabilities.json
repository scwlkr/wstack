{
  "version": 1,
  "probes": [
    {
      "feature": "save.md",
      "name": "save-and-reopen",
      "covers": ["save-title", "reject-empty"],
      "setup": ["python3", "driver.py", "setup"],
      "observe": ["python3", "driver.py", "observe"],
      "act": ["python3", "driver.py", "act"],
      "assert": ["python3", "driver.py", "assert"],
      "cleanup": ["python3", "driver.py", "cleanup"],
      "timeout_ms": 5000
    }
  ],
  "gaps": []
}
